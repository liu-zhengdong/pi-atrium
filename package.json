{
  "name": "@liuser/pi-atrium",
  "version": "0.3.0",
  "description": "Atrium 的 Pi 侧合集：ACP、MCP 代理、笔记",
  "license": "MIT",
  "author": "Sergii Kozak <svkozak@gmail.com>",
  "contributors": [
    "Filipe Regadas <oss@regadas.email>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/liu-zhengdong/pi-atrium.git"
  },
  "bugs": {
    "url": "https://github.com/liu-zhengdong/pi-atrium/issues"
  },
  "homepage": "https://github.com/liu-zhengdong/pi-atrium",
  "keywords": [
    "pi-package",
    "acp",
    "agent-client-protocol",
    "pi-coding-agent",
    "mcp",
    "notes"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pi-acp": "dist/index.js"
  },
  "pi": {
    "extensions": [
      "./adapter/index.ts",
      "./dist/pi-extension.js",
      "./notes/src/index.ts"
    ]
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "compile": "tsup",
    "start": "node dist/index.js",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/test.mjs && npm test --prefix adapter && npm test --prefix notes",
    "test:acp": "node scripts/test.mjs",
    "smoke": "node scripts/smoke-acp.mjs",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "eval:acp": "npm run compile && node scripts/eval-zed-acp.mjs",
    "validate": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run compile"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/ext-apps": "^1.2.2",
    "@napi-rs/keyring": "^1.3.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cross-spawn": "^7.0.6",
    "open": "^10.2.0",
    "recheck": "^4.5.0",
    "smol-toml": "^1.6.1",
    "strip-json-comments": "^5.0.3",
    "undici": "^6.28.1",
    "yaml": "2.9.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "3.8.3",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.0"
  },
  "overrides": {
    "tsup": {
      "esbuild": "^0.28.2"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true
  }
}
